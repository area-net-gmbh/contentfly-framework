<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random">

    <!-- Die Zeitzone des Testprozesses wird hier festgelegt, nicht der php.ini ueberlassen:
         tests/bootstrap.php setzt bewusst kein date_default_timezone_set(), sonst haenge die
         Suite davon ab, auf welcher Maschine sie laeuft. UTC ist die Zone, in der die API
         ihre Zeitstempel ausliefert - Tests pruefen damit dieselbe Annahme wie die Anwendung.

         Achtung: Der CLI-Schalter fuer date.timezone uebersteuert das NICHT. PHPUnit wendet
         diesen Block nach dem Schalter an, und PHP ignoriert die TZ-Umgebungsvariable, solange
         date.timezone gesetzt ist - beides scheitert stillschweigend. -->
    <php>
        <ini name="date.timezone" value="UTC"/>
    </php>

    <!-- Zwei Suiten, bewusst getrennt: `unit` laeuft ohne Datenbank und ohne Container und
         muss auf jedem Checkout gruen sein. `integration` braucht die Umgebung aus
         docker-compose.yml und eine durchgefuehrte Installation. Zusammengelegt stuende die
         ganze Suite still, sobald kein Container laeuft - und eine Suite, die haeufig rot ist,
         weil die Umgebung fehlt, wird nicht mehr gelesen.

         Der Aufruf ohne Argumente laeuft beide; mit dem testsuite-Schalter nur eine.
         Die Befehle stehen im Runbook. -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source restrictDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true">
        <include>
            <directory>lib/contentfly/Classes</directory>
            <directory>lib/contentfly/Controller</directory>
            <directory>custom/Classes</directory>
        </include>
        <exclude>
            <directory>custom/vendor</directory>
            <directory>vendor</directory>
        </exclude>
    </source>

    <!-- Keine fest verdrahteten Coverage-Berichte: Sie fordern bei JEDEM Lauf einen
         Coverage-Treiber an, und fehlt Xdebug oder PCOV, endet die Suite mit Exit-Code 1,
         obwohl jeder Test gruen ist. Eine Suite, die aus dem falschen Grund rot ist,
         verliert ihre Aussagekraft. Abdeckung wird deshalb angefordert, wenn man sie will:
         ./vendor/bin/phpunit with-coverage-text (siehe Runbook).
         Die Schreibweise "with-coverage-text" statt der echten Option ist Absicht:
         Zwei aufeinanderfolgende Bindestriche sind in einem XML-Kommentar nicht
         erlaubt, und der Parser bricht daran ab. -->
</phpunit>
