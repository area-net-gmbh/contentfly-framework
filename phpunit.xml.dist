<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random">

    <!-- The time zone of the test process is set here, not left to php.ini:
         tests/bootstrap.php deliberately does not call date_default_timezone_set(), otherwise the
         suite would depend on the machine it runs on. UTC is the zone in which the API delivers
         its timestamps - so tests check the same assumption as the application.

         Note: the CLI switch for date.timezone does NOT override this. PHPUnit applies this block
         after the switch, and PHP ignores the TZ environment variable as long as date.timezone
         is set - both fail silently. -->
    <php>
        <ini name="date.timezone" value="UTC"/>
    </php>

    <!-- Two suites, deliberately separate: `unit` runs without a database and without a
         container and has to be green on every checkout. `integration` needs the environment
         from docker-compose.yml and a completed installation. Combined, the whole suite would
         stand still as soon as no container runs - and a suite that is often red because the
         environment is missing stops being read.

         Running without arguments runs both; with the testsuite switch only one.
         The commands are in the runbook. -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source restrictDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true">
        <include>
            <directory>lib/contentfly/Classes</directory>
            <directory>lib/contentfly/Controller</directory>
            <directory>custom/Classes</directory>
        </include>
        <!-- NO EXCLUDE FOR vendor (000-000-0056). It stood here and emptied the list: excluding a
             directory walks it and follows symlinks, and vendor/areanet/contentfly is a symlink
             to lib/contentfly. Every framework file was resolved and excluded — 122 files became
             0, and "source" meant custom/Classes alone. That bent two things at once: coverage
             would have measured only the template, and restrictDeprecations/Notices/Warnings
             reported issues from custom/Classes only, so failOnWarning never saw the framework.
             Neither vendor nor custom/vendor lies inside an included directory; there is
             nothing to exclude. -->
    </source>

    <!-- No hard-wired coverage reports: they request a coverage driver on EVERY run, and
         without Xdebug or PCOV the suite ends with exit code 1 although every test is green. A
         suite that is red for the wrong reason loses its meaning. Coverage is therefore
         requested when wanted: ./vendor/bin/phpunit with-coverage-text (see runbook).
         Writing "with-coverage-text" instead of the real option is deliberate: two consecutive
         hyphens are not allowed in an XML comment, and the parser aborts on them. -->
</phpunit>
