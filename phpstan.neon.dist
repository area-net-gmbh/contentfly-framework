# PHPStan — die statische Hälfte des „0 Deprecations"-Gates (006-005-0004).
#
# WOZU. an_project/docs/tech-stack.md verlangt zwei Quellen: das Deprecation-Log und
# PHPStan. Das Log (006-005-0003) zeigt nur, was ein Testlauf tatsächlich AUSGEFÜHRT hat —
# eine deprecated API in einem Zweig, den die Suite nicht betritt, bleibt darin unsichtbar
# bis zum Upgrade. Diese Konfiguration findet sie ohne Ausführung.
#
# LEVEL 2 SEIT 000-000-0108 — was der Sprung gekostet und gebracht hat.
#
# Gemessen VOR dem Sprung: Level 1 = 25 Meldungen, Level 2 = 37. Keine Mauer. Der Ertrag waren
# fuenf echte Funde, der groesste in `FileController::overwriteAction()`: Dort wurde die
# Laufvariable einer foreach-Schleife HINTER der Schleife gelesen — leeres Quellverzeichnis,
# undefinierte Variable, Fatal mitten im Ueberschreiben. Dazu zwei Variablen, die ein
# catch-Zweig las, ohne dass die Schleife, die sie setzt, gelaufen sein musste.
#
# Von den 37 waren 21 dieselbe Meldung: `$app might not be defined` in Dateien, die in einen
# Scope hinein eingebunden werden. Kein Fehler, sondern eine Zusage, die PHPStan nicht kennen
# kann — sie steht unten als benannte Ausnahme, der Vertrag selbst im Kopf jener Dateien.
#
# LEVEL 3 IST EIN EIGENER TASK: Dort kommen die Rueckgabetypen dazu, und diese Zahl ist nicht
# gemessen.
#
# ── Was bis 000-000-0108 hier stand ──────────────────────────────────────────────────
#
# LEVEL 0, UND DAS WAR ABSICHT — GEPRÜFT MIT 009-003-0003.
# Die Deprecation-Regeln aus phpstan/phpstan-deprecation-rules greifen unabhängig vom
# Level; sie brauchen keinen hohen. Der ursprüngliche Grund für Level 0 war, dass ein
# höherer Level auf einem Silex-2-Baum viele Typfehler hereinzöge, in denen die
# Deprecations untergehen.
#
# Silex ist weg, und die Rechnung sieht jetzt anders aus: Auf Level 0 stehen NULL eigene
# Typfehler. Die sieben, die es gab, waren keine Formalie — darunter eine Konstante, die
# es nicht gibt und die eine unique-Verletzung in einen Fatal verwandelte (009-003-0002).
# Der Level blieb damals bei 0: Ihn anzuheben sei eine eigene Entscheidung mit eigenem
# Aufwand. Das Ticket dafuer ist 000-000-0108, und es ist eingeloest.
#
# KEINE BASELINE, UND DAS IST DER PUNKT — UNVERÄNDERT.
# Eine Baseline friert den Ist-Stand ein und macht den Job sofort grün. Was hier steht,
# ist stattdessen eine benannte Liste: je Meldung ein Eintrag mit Grund und auflösendem
# Epic. Derselbe Aufbau wie tools/ci/deprecations-ausnahmen.txt und wie config.audit.ignore
# in composer.json (006-005). Und dieselbe Eigenschaft, die dort Regel 3 heisst: PHPStan
# meldet einen Eintrag, der nichts mehr trifft, als Fehler — eine Erlaubnis ins Leere macht
# den Lauf rot, statt stillschweigend stehen zu bleiben.
#
# DER JOB IST SEIT 009-003-0003 BLOCKIEREND.
# Die Bedingung, die hier stand, lautete: "Sobald `vendor/`-fremde Treffer auf null stehen."
# Sie ist erfüllt. Von 115 Meldungen sind 31 übrig, und alle 31 kommen aus Doctrine —
# Annotationen, cache und die Console-Commands des ORM. Sie stehen unten benannt und
# fallen mit Epic 010. allow_failure gibt es in der Pipeline nicht mehr.

parameters:
    level: 2

    paths:
        - lib
        - custom
        - bin
        - tests

    # `vendor/` wird NICHT analysiert: Was dort deprecated ist, ist nicht unsere Baustelle,
    # sondern die von Epic 009 (Silex/Symfony) und 010 (Doctrine). PHPStan liest den Baum
    # trotzdem, um Typen aufzulösen — nur meldet es nichts darüber.
    excludePaths:
        - vendor
        - custom/vendor

    # Die Konstanten, die lib/contentfly/bootstrap.php zur Laufzeit setzt und die
    # Entity-Klassen schon beim Laden in ihren Annotationen lesen. Ohne sie meldet PHPStan
    # sie als undefiniert — ein Rauschen, das mit Deprecations nichts zu tun hat.
    # Dieselbe Liste wie in tests/bootstrap.php.
    bootstrapFiles:
        - tests/bootstrap.php

    # Das Inventar-Werkzeug fuer Bestandsprojekte (007-005-0001) liegt unter tools/ und damit
    # ausserhalb der analysierten Pfade; sein Test ruft seine Funktionen. Nur einlesen, nicht
    # analysieren — tools/ insgesamt in die Analyse zu ziehen waere eine eigene Entscheidung.
    scanFiles:
        - tools/migration/inventory.php
        - tools/migration/record-api.php
        - tools/migration/dbal3-statements.php

    # ── Die benannte Ausnahmeliste (009-003-0003) ────────────────────────────────────
    #
    # Jeder Eintrag nennt, was ihn aufloest. Ohne benanntes Epic ist es keine Ausnahme,
    # sondern ein abgeschaltetes Gate — dieselbe Regel wie bei den Deprecation- und
    # Audit-Ausnahmen aus 006-005.
    #
    # ALLE 31 KOMMEN AUS DOCTRINE und fallen mit Epic 010 (ORM 2 -> 3, Annotationen ->
    # Attribute, Ersatz fuer das abandoned doctrine/annotations und doctrine/cache).
    # Sie stehen hier als MELDUNG, nicht als Datei-und-Zeile: Eine Zeilennummer haette die
    # Liste bei jeder Codeaenderung brechen lassen.
    ignoreErrors:
        # `newDefaultAnnotationDriver()` ist mit 010-001-0003 aus der EntityManagerFactory
        # verschwunden, und das Muster traf sonst nichts mehr — Regel 3 hat es eingefordert.
        #
        # ES BLEIBT EINE BLINDE STELLE: `Classes/Plugin.php` ruft die Methode weiterhin. PHPStan
        # meldet sie dort NICHT, weil `$this->app['orm.em']` ueber ArrayAccess `mixed` liefert
        # und der Typ der Konfiguration damit unbekannt ist. Das Muster hat diese Stelle also nie
        # abgedeckt; sein Wegfall verdeckt nichts. Der Plugin-Pfad wird mit 010-001-0004
        # entschieden.

        # doctrine/cache: Das Muster fuer die vier Cache-Klassen ist mit 010-002-0002
        # entfallen — der Bootstrap instanziiert keine mehr. Regel 3 hat es eingefordert:
        # Ein Muster, das nichts mehr trifft, macht den Lauf rot. Das Paket selbst nimmt
        # 010-002-0004 aus dem Manifest.

        # doctrine/orm 2.x — Klassen und Methoden, die in ORM 3 entfallen (Epic 010).
        #
        # Zwei Muster sind mit 010-003-0001 weggefallen, weil die Aufrufe es sind:
        # `EntityManager::create()` und die Lexer-Token-Konstanten. Beide Ziele gibt es in ORM
        # 2.20 bereits, die Umstellung brauchte den Versionssprung also nicht — und Regel 3
        # hat die Muster sofort eingefordert.
        #
        # Mit dem Sprung selbst (010-003-0002) sind zwei weitere weggefallen: Die
        # ORM-Console-Commands sind in ORM 3 nicht mehr deprecated, sondern gewoehnlich, und
        # `createHelperSet()` gibt es nicht mehr — `bin/cli-config.php` benutzt einen Provider.
        #
        # Uebrig ist genau eine Ausnahme, und sie kommt aus DBAL, nicht aus dem ORM.
        - '#Instantiation of deprecated class Doctrine\\DBAL\\Tools\\Console\\Command\\ReservedWordsCommand#'

        # ── Ausnahmen aus dem Sprung auf Level 2 (000-000-0108) ──────────────────────
        #
        # `$app` in eingebundenen Dateien. `bootstrap-web.php` und `custom/app.php` werden in
        # einen Scope hinein eingebunden, in dem `$app` bereits existiert — das ist ihr Vertrag,
        # und er steht seit 000-000-0108 in ihrem Kopf. PHPStan kann ihn nicht kennen: Es
        # analysiert jede Datei fuer sich, und `might not be defined` fragt nach der
        # DEFINIERTHEIT, die ein `@var` nicht beantwortet — das gibt nur einen Typ. Beim
        # Umsetzen gemessen: ein `@var` am Dateikopf aendert nichts, eines ueber der ersten
        # Verwendung auch nicht.
        -
            message: '#Variable \$app might not be defined#'
            path: lib/contentfly/bootstrap-web.php
        -
            message: '#Variable \$app might not be defined#'
            path: custom/app.php

        # Der Container loest Factories erst beim Zugriff auf. PHPStan verfolgt die Zuweisung
        # `$app['typeManager'] = function …` und meldet beim Lesen die Closure — zur Laufzeit
        # gibt `offsetGet()` das gebaute Objekt heraus. Dieselbe blinde Stelle, die weiter oben
        # schon fuer `$this->app['orm.em']` beschrieben ist.
        -
            message: '#Call to an undefined method Closure::registerType\(\)#'
            path: lib/contentfly/Command/InstallCommand.php

        # Config traegt #[AllowDynamicProperties], und GENAU DAS prueft dieser Test
        # (000-000-0040): Ein Projekt darf eigene Schluessel setzen. Eine Meldung ueber eine
        # undefinierte Property ist hier die Zusage, nicht ihr Bruch.
        -
            message: '#Access to an undefined property .*Config::\$CUSTOM_SMTP_HOST#'
            path: tests/Unit/Config/ProjectKeysTest.php

includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
