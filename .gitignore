.vagrant/*
# Ignore composer.lock everywhere (vendor-internal locks are noise)…
composer.lock
# …EXCEPT the app's own locks: commit them for reproducible CI (pins versions) +
# `composer audit --locked` (spec 069 §5.2).
#
# Der fuehrende Slash bei /composer.lock ist noetig: Ohne ihn greift die Ausnahme auf jeder
# Ebene und holt genau die vendor-internen Locks zurueck, die die Regel darueber fernhaelt.
# Der Root-Lock kam mit 006-002-0003 dazu.
!/composer.lock

# Die Vendor-Baeume entstehen seit 006-003-0001 beim Build, nicht in Git. Vorher lagen hier
# 11 208 committete Dateien — eine Notloesung aus der Zeit ohne Root-Manifest; die Begruendung
# von damals steht in an_project/docs/technical.md.
#
# Beide Pfade sind einzeln und verankert genannt. Ein unverankertes "vendor/" wuerde zwar
# ebenfalls beide erfassen, aber auf JEDER Ebene — auch ein kuenftiges plugins/x/vendor, das
# vielleicht committet gehoert. Wer eine Regel schreibt, die mehr kann als sie soll, merkt es
# erst, wenn sie zuschlaegt.
/vendor/
/custom/vendor/
.idea/*
ansible/*
# Anchored (leading slash): unanchored 'template' matched vendor dirs on every
# level (case-insensitive on APFS) and silently swallowed 34 PHPUnit .tpl files.
/template
# docker-compose.yml und docker/ waren hier ausgeschlossen - uebernommen aus dem
# Kundenprojekt, wo die Compose-Datei bewusst ausserhalb des Repos lag. In einem
# Framework-Repo ist sie Teil der Vorlage: Ein frischer Checkout soll ohne fremde
# Zutaten eine Datenbank hochfahren koennen (Task 000-000-0003).
Vagrantfile
# Laufzeitdaten bleiben draussen - die Verzeichnisse selbst gehoeren ins Repo.
# Der Installer schreibt in data/files und data/cache (Doctrine-Proxies); ohne die
# Verzeichnisse ist ein frischer Checkout nicht installierbar.
data/*/*
!data/*/.gitkeep
profiler/*
backup/*
# Dasselbe fuer plugins/: Was ein Projekt dort ablegt, bleibt draussen - das Verzeichnis
# selbst gehoert ins Repo. Bis 011-002-0004 fehlte die Ausnahme, und damit fehlte
# plugins/ in JEDEM frischen Checkout: Git fuehrt keine leeren Verzeichnisse. Lokal fiel
# es nie auf, weil Testlaeufe das Verzeichnis anlegen; gefunden hat es das
# Bezugsweg-Gate beim ersten Lauf in der CI.
plugins/*
!plugins/.gitkeep
# Anchored: unanchored 'info.php' matched PHPUnit's Event/.../Telemetry/Info.php
# (case-insensitive on APFS) and broke `make ci-backend` on a fresh clone.
/info.php
.DS_Store
.vscode
# Composer-Temp-Artefakte aus abgebrochenen Downloads
*.zip~
# Vendored npm-Debug-Logs aus bower_components (funktionslos)
npm-debug.log

# --- ki-dev-framework ---------------------------------------------------
# NOTE: `.an_framework/` is deliberately NOT ignored. Since v2 the framework
# core is committed into the project as plain files (it is no longer a git
# submodule), so a plain `git clone` reproduces the exact framework version —
# no `--recurse-submodules`, no `git submodule update`. Never add a rule that
# ignores `.an_framework/`. Mind that the broad credential patterns below match
# at ANY depth: the `!.an_framework/**` un-ignore at the very end is what keeps
# them from silently dropping a framework file on `git add`.

.claude/settings.local.json
CLAUDE.local.md

# PHPUnit-Ergebniscache: Laufzeitartefakt, gehoert niemandem im Team.
.phpunit.cache/
.phpunit.coverage/
# Coverage-Berichte aus dem lokalen Lauf, runbook.md Abschnitt 4 (000-000-0056)
/build/coverage/
# Versandfalle der Integration-Suite, wenn jemand den Pfad der Pipeline lokal nachstellt
# (CONTENTFLY_TEST_MAIL_TRAP in pipeline.yml). tests/README.md legt sie unter /tmp an (000-000-0089).
/.ci-mailtrap/
# Ausgabe von Claude Code Security (000-000-0101): Bericht, SARIF und Patch-Vorschlaege eines
# Scans. Das Repository ist oeffentlich - ein committeter Bericht veroeffentlichte Luecken, bevor
# sie behoben sind.
/CLAUDE-SECURITY-*/

# Operating system — macOS
.DS_Store
.AppleDouble
._*

# Operating system — Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# IDEs / editors — JetBrains
.idea/
.idea_modules/
*.iml

# Credentials — git should not offer these in the first place. `/commit` screens a
# deliberately WIDER set (see step 5 of .an_framework/commands/commit.md) and stops on
# anything this list misses. Keep that asymmetry: the screen may use a broad pattern
# like `*credentials*` because it only stops and asks — here the same pattern would
# silently hide legitimate source such as `src/credentials.ts` from `git status`.
# The three negations must stay directly after `.env.*`. Add your own paths below.
.env
.env.*
!.env.example
!.env.dist
!.env.sample
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
credentials.json
*-credentials.json

# Keep the committed framework core intact: re-include anything the broad
# credential globs above would otherwise drop from `.an_framework/`. This line
# must stay LAST — later patterns win in .gitignore.
!.an_framework/**

# Die erzeugte API-Dokumentation (000-000-0053) - ein Build-Ergebnis, kein Quelltext.
/build/apidoc/
