{% if workspaceName %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="box-sizing: border-box; border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; max-width: 600px; min-width: 420px; margin: 0 auto;">
   <tbody style="box-sizing: border-box;">
      <tr style="box-sizing: border-box;">
         <td class="mobile-padding-lr" style="box-sizing: border-box; border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; background: #F5F5F5; border-top: 1px solid #EDEDED; border-bottom: 1px solid #EDEDED; padding: 12px 30px; font-family: Roboto, Arial, sans-serif; font-size: 13px; line-height: 18px; color: #5f5f5f;">
            {% if language == 'de' %}Workspace{% else %}Workspace{% endif %}: <strong style="box-sizing: border-box; color: #313030;">{{ workspaceName }}</strong>{% if workspaceHost %} &middot; <a href="{{ workspaceUrl }}" target="_blank" style="box-sizing: border-box; color: #3C80AC; text-decoration: none;">{{ workspaceHost }}</a>{% endif %}
         </td>
      </tr>
   </tbody>
</table>
{% endif %}
