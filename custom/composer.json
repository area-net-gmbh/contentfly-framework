        "phpmailer/phpmailer": "^6.10",
        "sentry/sentry": "^4.22",
        "stripe/stripe-php": "^18.0",
        "vlucas/phpdotenv": "^5.6",
        "onelogin/php-saml": "^4.3.2",
        "robrichards/xmlseclibs": "^3.1.5"
    },
    "require-dev": {
